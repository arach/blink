    "blink-app": "./bin/blink-app.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "keywords": [
    "blink",
    "notes",
    "macos",
    "menubar",
    "cli",
    "agents",
    "spatial",
